{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "veduta/schemas/architecture/v1",
  "title": "veduta architecture diagram IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "components"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "diagram_type": { "type": "string", "enum": ["architecture"] },
    "meta": { "$ref": "#/$defs/meta" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/component" }
    },
    "boundaries": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/boundary" }
    },
    "connections": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/connection" }
    },
    "cards": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "coord": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/coord" }
    },
    "size2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 10, "maximum": 4000 }
    },
    "side": {
      "type": "string",
      "enum": ["left", "right", "top", "bottom"]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "output": { "type": "string", "minLength": 6, "maxLength": 300 },
        "quality_profile": { "type": "string", "enum": ["standard", "showcase"] },
        "animation": { "type": "string", "enum": ["trace"] },
        "visual_preset": { "type": "string", "enum": ["classic", "signal-flow", "blueprint", "editorial"] },
        "locale": { "type": "string", "enum": ["en", "ja", "zh-CN"] },
        "viewBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/coord" }
        },
        "views": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/view" }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/id" }
        },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "pos", "size"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "type": "string",
          "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sublabel": { "type": "string", "maxLength": 200 },
        "tag": { "type": "string", "maxLength": 80 },
        "pos": { "$ref": "#/$defs/vec2" },
        "size": { "$ref": "#/$defs/size2" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "wraps"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["region", "zone", "vpc", "subnet", "cluster", "network", "security", "trust"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "wraps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "maxLength": 200 },
        "variant": { "type": "string", "enum": ["default", "emphasis", "security", "dashed"] },
        "fromSide": { "$ref": "#/$defs/side" },
        "toSide": { "$ref": "#/$defs/side" },
        "via": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/vec2" }
        },
        "labelDy": { "type": "number", "minimum": -500, "maximum": 500 },
        "labelAt": { "type": "number", "minimum": 0, "maximum": 1 },
        "channelX": { "$ref": "#/$defs/coord" },
        "channelY": { "$ref": "#/$defs/coord" }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "dot": {
          "type": "string",
          "enum": ["cyan", "blue", "green", "amber", "red", "purple", "gray"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
